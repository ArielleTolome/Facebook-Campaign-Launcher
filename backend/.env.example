# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_NAME=facebook_campaign_launcher
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Facebook API Configuration
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret
FB_ACCESS_TOKEN=your_facebook_access_token
FB_API_VERSION=v18.0

# Notification Service Configuration
# Email Service: 'sendgrid', 'ses', or 'smtp'
EMAIL_SERVICE=smtp
EMAIL_FROM=noreply@campaign-launcher.com

# SendGrid Configuration (if EMAIL_SERVICE=sendgrid)
SENDGRID_API_KEY=your_sendgrid_api_key

# AWS SES Configuration (if EMAIL_SERVICE=ses)
AWS_SES_HOST=email-smtp.us-east-1.amazonaws.com
AWS_SES_ACCESS_KEY=your_aws_ses_access_key
AWS_SES_SECRET_KEY=your_aws_ses_secret_key

# SMTP Configuration (if EMAIL_SERVICE=smtp)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
